# TaskFlow api settings. These are read from the process environment (no .env loader);
# export them or prefix the command, e.g.  TASKFLOW_ACTOR=alice npm run dev
PORT=3001
# Default: api/data/taskflow.db (absolute path resolved by the api). Use :memory: for a throwaway DB.
# TASKFLOW_DB_PATH=/absolute/path/to/taskflow.db
TASKFLOW_ACTOR=demo-operator
TASKFLOW_SEED=true
