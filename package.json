{
  "name": "taskflow",
  "version": "0.1.0",
  "private": true,
  "description": "TaskFlow — a small task manager used as the Salvor cross-vendor engineering-memory demo",
  "type": "module",
  "workspaces": [
    "shared",
    "api",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w api\" \"npm run dev -w web\"",
    "start": "npm run start -w api",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:audit": "bash scripts/verify-audit.sh"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
